# TNSR needs no API keys. All settings are optional.

# Where experiments/, datasets/, checkpoints/ and var/ live (default: current directory)
# TNSR_HOME=/path/to/tnsr-data

# SQLite database for conversations, settings and job metadata (default: $TNSR_HOME/var/tnsr.db)
# TNSR_DB=/path/to/tnsr.db

# Inference device for the server: auto | cpu | cuda | mps (default: auto)
# TNSR_DEVICE=auto

# Serve a UI build from a different directory (default: tnsr_ui/dist)
# TNSR_UI_DIST=/path/to/dist

# Backend URL used by the Vite dev server proxy (default: http://127.0.0.1:8000)
# TNSR_API=http://127.0.0.1:8000

# Allow PyTorch to fall back to CPU for operations missing on Apple MPS
# PYTORCH_ENABLE_MPS_FALLBACK=1
